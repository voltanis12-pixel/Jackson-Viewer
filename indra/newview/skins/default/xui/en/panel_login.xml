<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel follows="all" height="768" layout="topleft" name="panel_login" focus_root="true" background_visible="false" background_opaque="false" width="1024">
  <panel.string name="forgot_password_url">
    http://secondlife.com/account/request.php
  </panel.string>
  <panel.string name="sign_up_url">
    https://join.secondlife.com/
  </panel.string>
  <!-- Jackson Viewer static scenic background. -->
  <icon follows="all" height="768" image_name="first_login_image" layout="topleft" left="0" name="login_background" scale_image="true" top="0" width="1024" />
  <!-- Hidden browser retained for compatibility with LLPanelLogin. -->
  <panel follows="left|top" height="1" layout="topleft" left="-4000" name="web_container" background_visible="false" background_opaque="false" top="-4000" width="1">
    <web_browser tab_stop="false" trusted_content="true" border_visible="false" follows="all" left="0" top="0" right="0" bottom="0" name="login_html" start_url="" />
  </panel>
  <!--
       REAL LOGIN CARD
       The ornate card skin is a separate UI texture (login_sl_logo.png),
       independently positioned from the scenic background.
  -->
  <panel follows="right|top" height="665" layout="topleft" right="-10" name="login_card" background_visible="false" background_opaque="false" top="675" width="620">
    <icon follows="all" height="665" image_name="login_sl_logo" layout="topleft" left="0" name="login_card_skin" scale_image="true" top="0" width="620" />
    <!-- Cover only the baked placeholder text portions while preserving
         the decorative icons and field borders from the card skin. -->
    <panel follows="left|top" height="1" left="-4000" top="-4000" width="1" background_visible="true" bg_opaque_color="0.012 0.025 0.055 1" background_opaque="true" name="username_clean_area" visible="false" />
    <combo_box follows="left|top" left="155" top="194" allow_text_entry="true" layout="topleft" height="44" label="Username" combo_editor.font="SansSerifMedium" max_chars="128" combo_editor.commit_on_focus_lost="false" combo_editor.prevalidator="ascii" tool_tip="The username you chose when you registered" name="username_combo" width="365">
      <combo_box.combo_button image_overlay="ComboButton_Transparent" image_unselected="ComboButton_Transparent" hover_glow_amount="0" image_selected="ComboButton_Transparent" image_disabled="ComboButton_Transparent" />
      <combo_box.combo_editor background_image="TextField_Transparent" background_image_disabled="TextField_Transparent" background_image_focused="TextField_Transparent" draw_focus_border="false" text_pad_left="8" text_color="0.91 0.84 0.70 1" bg_image_always_focused="true" />
    </combo_box>
    <panel follows="left|top" height="1" left="-4000" top="-4000" width="1" background_visible="true" bg_opaque_color="0.012 0.025 0.055 1" background_opaque="true" name="password_clean_area" visible="false" />
    <line_editor follows="left|top" height="44" left="155" top="270" max_length_chars="64" text_pad_left="8" name="password_edit" label="Password" bg_image="TextField_Transparent" bg_image_disabled="TextField_Transparent" bg_image_focused="TextField_Transparent" bg_image_always_focused="true" font="SansSerifMedium" text_color="0.91 0.84 0.70 1" is_password="true" select_on_focus="true" draw_focus_border="false" commit_on_focus_lost="false" width="365" bg_color="0 0 0 0" />
    <panel follows="left|top" height="1" left="-4000" top="-4000" width="1" background_visible="true" bg_opaque_color="0.012 0.025 0.055 1" background_opaque="true" name="location_clean_area" visible="false" />
    <text follows="left|top" font="SansSerifMedium" text_color="White" height="28" left="150" name="location_text" top="282" width="105" valign="center" visible="false">
      Log in to:
    </text>
    <combo_box follows="left|top" allow_text_entry="true" control_name="NextLoginLocation" label="Last Location" height="44" left="155" max_chars="128" combo_editor.font="SansSerifMedium" top="344" name="start_location_combo" width="365" combo_button.scale_image="true">
      <combo_box.combo_button image_overlay="ComboButton_Transparent" image_unselected="ComboButton_Transparent" image_selected="ComboButton_Transparent" image_disabled="ComboButton_Transparent" hover_glow_amount="0" />
      <combo_box.combo_editor background_image="TextField_Transparent" background_image_disabled="TextField_Transparent" background_image_focused="TextField_Transparent" draw_focus_border="false" text_pad_left="8" text_color="0.91 0.84 0.70 1" bg_image_always_focused="true" />
      <combo_box.item label="My last location" name="MyLastLocation" value="last" />
      <combo_box.item label="My home" name="MyHome" value="home" />
    </combo_box>
    <!-- Hide legacy Remember Username, but retain it for login credential code. -->
    <check_box follows="left|top" font="SansSerifSmall" label_text.text_color="White" left="-4000" top="-4000" layout="topleft" height="22" label="Remember username" name="remember_name" width="160" visible="false">
      <check_box.label_text left="23" />
      <check_box.check_button image_selected="Checkbox_Slim_On" image_unselected="Checkbox_Slim_Off" image_pressed="Checkbox_Slim_Off" image_pressed_selected="Checkbox_Slim_Off" />
    </check_box>
    <!-- Cover the baked Remember-me state and use the real checkbox. -->
    <panel follows="left|top" height="1" left="-4000" top="-4000" width="1" background_visible="true" bg_opaque_color="0.024 0.078 0.173 1" background_opaque="true" name="remember_clean_area" visible="false" />
    <check_box control_name="RememberPassword" follows="left|top" font="SansSerifMedium" label_text.text_color="0.91 0.84 0.70 1" height="34" left="105" top="397" label="" name="remember_password" width="34">
      <check_box.label_text left="42" />
      <check_box.check_button image_selected="Checkbox_Slim_On" image_unselected="ComboButton_Transparent" image_pressed="ComboButton_Transparent" image_pressed_selected="Checkbox_Slim_On" />
    </check_box>
    <!-- Transparent live buttons over the ornate button artwork. -->
    <button follows="left|top" image_unselected="ComboButton_Transparent" image_pressed="ComboButton_Transparent" image_hover_unselected="ComboButton_Transparent" label="" name="connect_btn" draw_focus_border="false" hover_hand_cursor="true" enabled="true" width="500" height="82" left="60" top="444" pad_bottom="1" />
    <button follows="left|top" image_unselected="ComboButton_Transparent" image_pressed="ComboButton_Transparent" image_hover_unselected="ComboButton_Transparent" label="" name="sign_btn" draw_focus_border="false" hover_hand_cursor="true" width="385" height="50" left="118" top="542" pad_bottom="1" />
  </panel>
  <!-- Footer callback. -->
  <text follows="right|bottom" font="SansSerifSmall" text_color="0.91 0.84 0.70 1" height="18" name="forgot_password_text" right="-237" bottom="20" width="130" halign="center">
    Forgot Password?
  </text>
  <!-- Hidden compatibility stack expected by LLPanelLogin. -->
  <layout_stack follows="left|top" layout="topleft" orientation="horizontal" name="login_stack" border_size="0" animate="false" top="-4000" left="-4000" height="1" width="1" visible="false">
    <layout_panel auto_resize="false" user_resize="false" layout="topleft" name="grid_panel" background_visible="false" height="1" width="1">
      <combo_box allow_text_entry="false" font="SansSerifTiny" follows="left|top" height="1" top="0" left="0" max_chars="128" label="Select grid" layout="topleft" name="server_combo" width="1">
        <combo_box.drop_down_button image_overlay="ComboButton_Arrow" image_unselected="TextField_Active" image_selected="TextField_Active" image_pressed="TextField_Active" image_pressed_selected="TextField_Active" />
      </combo_box>
    </layout_panel>
  </layout_stack>
  <!-- Legacy logo object retained but hidden because its registered texture
       slot is now used by the separate ornate login-card skin. -->
  <icon height="1" width="1" image_name="login_sl_logo_horizontal" layout="topleft" follows="left|bottom" left="-4000" top="-4000" name="sl_logo_small" visible="false" />
</panel>