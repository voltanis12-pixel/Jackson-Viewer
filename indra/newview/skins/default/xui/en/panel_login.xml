<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 follows="all"
 height="768"
 layout="topleft"
 name="panel_login"
 focus_root="true"
 background_visible="true"
 bg_opaque_color="DkGrayLogin"
 background_opaque="true"
 width="1024">

  <panel.string name="forgot_password_url">
    http://secondlife.com/account/request.php
  </panel.string>

  <panel.string name="sign_up_url">
    https://join.secondlife.com/
  </panel.string>

  <!-- Full-screen custom background -->
  <icon
   follows="all"
   height="768"
   image_name="first_login_image"
   layout="topleft"
   left="0"
   name="login_background"
   scale_image="true"
   top="0"
   width="1024" />

  <!-- v8 isolated change:
       Compress the top destination/browser area so it behaves like a thin top rail.
       Bottom login rail remains unchanged from the v7 passing layout. -->
  <panel
   follows="left|right|top"
   height="84"
   layout="topleft"
   left="0"
   name="web_container"
   background_visible="true"
   bg_opaque_color="DkGrayLogin"
   background_opaque="true"
   top="0"
   width="1024">

    <web_browser
     tab_stop="false"
     trusted_content="true"
     bg_opaque_color="DkGrayLogin"
     border_visible="false"
     follows="all"
     left="0"
     top="0"
     right="-1"
     bottom="-1"
     name="login_html"
     start_url="" />
  </panel>

  <!-- Passed compact bottom rail -->
  <panel
   follows="left|right|bottom"
   height="130"
   layout="topleft"
   left="0"
   name="login_rail"
   background_visible="true"
   bg_opaque_color="PanelDark"
   background_opaque="true"
   top="638"
   width="1024">

    <layout_stack
     follows="all"
     layout="topleft"
     orientation="horizontal"
     name="rail_centering_stack"
     border_size="0"
     animate="false"
     left="0"
     top="0"
     height="130"
     width="1024">

      <layout_panel
       auto_resize="true"
       user_resize="false"
       layout="topleft"
       name="rail_left_spacer"
       background_visible="false"
       min_width="0"
       expanded_min_dim="0"
       width="1" />

      <layout_panel
       auto_resize="false"
       user_resize="false"
       layout="topleft"
       name="ui_container"
       background_visible="false"
       height="130"
       width="1000">

        <icon
         height="80"
         width="160"
         image_name="login_sl_logo_horizontal"
         layout="topleft"
         follows="left|bottom"
         left="10"
         top="25"
         name="sl_logo_small" />

        <icon
         left="180"
         top="30"
         width="190"
         height="32"
         image_name="TextField_Active"
         layout="topleft"
         follows="left|bottom"
         name="text_field_bg1" />

        <combo_box
         left="180"
         top="30"
         allow_text_entry="true"
         follows="left|bottom"
         layout="topleft"
         height="32"
         label="Username"
         combo_editor.font="SansSerifMedium"
         max_chars="128"
         combo_editor.commit_on_focus_lost="false"
         combo_editor.prevalidator="ascii"
         tool_tip="The username you chose when you registered, like bobsmith12 or Steller Sunshine"
         name="username_combo"
         width="190">

          <combo_box.combo_button
           image_overlay="ComboButton_Arrow"
           image_overlay_right_delta="10"
           image_unselected="ComboButton_Transparent"
           hover_glow_amount="0"
           image_selected="ComboButton_Transparent"
           image_disabled="ComboButton_Transparent" />

          <combo_box.combo_editor
           background_image="TextField_Transparent"
           background_image_disabled="TextField_Transparent"
           background_image_focused="TextField_Transparent"
           draw_focus_border="false"
           text_pad_left="8"
           bg_image_always_focused="true" />
        </combo_box>

        <check_box
         follows="left|bottom"
         font="SansSerifSmall"
         label_text.text_color="White"
         left="180"
         top="68"
         layout="topleft"
         height="22"
         label="Remember username"
         word_wrap="down"
         check_button.bottom="3"
         name="remember_name"
         tool_tip="Already remembered user can be forgotten from Me &gt; Preferences &gt; Advanced &gt; Remembered Usernames."
         width="190">

          <check_box.label_text left="23" />

          <check_box.check_button
           image_selected="Checkbox_Slim_On"
           image_unselected="Checkbox_Slim_Off"
           image_pressed="Checkbox_Slim_Off"
           image_pressed_selected="Checkbox_Slim_Off" />
        </check_box>

        <line_editor
         follows="left|bottom"
         height="32"
         left="385"
         top="30"
         max_length_chars="16"
         text_pad_left="8"
         name="password_edit"
         label="Password"
         bg_image_always_focused="true"
         font="SansSerifMedium"
         is_password="true"
         select_on_focus="true"
         draw_focus_border="false"
         commit_on_focus_lost="false"
         width="190" />

        <check_box
         control_name="RememberPassword"
         follows="left|bottom"
         font="SansSerifSmall"
         label_text.text_color="White"
         height="22"
         left="385"
         top="68"
         label="Remember password"
         word_wrap="down"
         check_button.bottom="3"
         name="remember_password"
         width="190">

          <check_box.label_text left="23" />

          <check_box.check_button
           image_selected="Checkbox_Slim_On"
           image_unselected="Checkbox_Slim_Off"
           image_pressed="Checkbox_Slim_Off"
           image_pressed_selected="Checkbox_Slim_Off" />
        </check_box>

        <text
         follows="left|bottom"
         font="SansSerifSmall"
         text_color="White"
         height="14"
         left="590"
         name="location_text"
         top="10"
         width="120"
         valign="center">
          Start here
        </text>

        <icon
         left="590"
         top="30"
         width="190"
         height="32"
         image_name="TextField_Active"
         layout="topleft"
         follows="left|bottom"
         name="text_field_bg2" />

        <combo_box
         allow_text_entry="true"
         control_name="NextLoginLocation"
         follows="left|bottom"
         label="My favorite places"
         height="32"
         left="590"
         max_chars="128"
         combo_editor.font="SansSerifMedium"
         top="30"
         name="start_location_combo"
         width="190"
         combo_button.scale_image="true">

          <combo_box.combo_button
           image_overlay="ComboButton_Arrow"
           hover_glow_amount="0"
           image_overlay_right_delta="10"
           image_unselected="ComboButton_Transparent"
           image_selected="ComboButton_Transparent"
           image_disabled="ComboButton_Transparent" />

          <combo_box.combo_editor
           background_image="TextField_Transparent"
           background_image_disabled="TextField_Transparent"
           background_image_focused="TextField_Transparent"
           draw_focus_border="false"
           text_pad_left="8"
           bg_image_always_focused="true" />

          <combo_box.item
           label="My last location"
           name="MyLastLocation"
           value="last" />

          <combo_box.item
           label="My home"
           name="MyHome"
           value="home" />
        </combo_box>

        <!-- Keep grid selector inside its own stack so the viewer can still collapse/relayout it safely -->
        <layout_stack
         follows="left|bottom"
         layout="topleft"
         orientation="horizontal"
         name="login_stack"
         border_size="0"
         animate="false"
         top="68"
         left="590"
         height="52"
         width="190">

          <layout_panel
           auto_resize="false"
           user_resize="false"
           layout="topleft"
           name="grid_panel"
           background_visible="false"
           height="52"
           width="190">

            <text
             follows="left|top"
             font="SansSerifSmall"
             text_color="White"
             height="12"
             name="grid_text"
             top="0"
             left="0"
             width="80"
             valign="center">
              Grid
            </text>

            <combo_box
             allow_text_entry="false"
             font="SansSerifTiny"
             follows="left|top"
             height="30"
             top="16"
             left="0"
             max_chars="128"
             label="Select grid"
             layout="topleft"
             name="server_combo"
             width="190">

              <combo_box.drop_down_button
               pad_bottom="1"
               pad_left="10"
               font="SansSerifMedium"
               label_color="Black"
               label_color_selected="Black"
               draw_focus_border="false"
               image_overlay="ComboButton_Arrow"
               image_overlay_right_delta="10"
               image_unselected="TextField_Active"
               image_selected="TextField_Active"
               image_pressed="TextField_Active"
               image_pressed_selected="TextField_Active" />
            </combo_box>
          </layout_panel>
        </layout_stack>

        <!-- Action buttons kept as direct children of ui_container -->
        <panel
         follows="left|bottom"
         layout="topleft"
         left="795"
         top="15"
         name="login_panel"
         background_visible="false"
         height="105"
         width="195">

          <button
           follows="left|top"
           image_unselected="PushButton_Login"
           image_pressed="PushButton_Login_Pressed"
           image_hover_unselected="PushButton_Login_Over"
           label="Log in"
           label_color="Black"
           label_color_disabled="Black"
           font="SansSerifMedium"
           font.style="BOLD"
           name="connect_btn"
           draw_focus_border="false"
           hover_hand_cursor="true"
           enabled="true"
           width="195"
           height="36"
           left="0"
           top="5"
           pad_bottom="1" />

          <text
           follows="left|top"
           font="SansSerifSmall"
           text_color="EmphasisColor"
           height="16"
           name="forgot_password_text"
           left="0"
           top="45"
           width="195"
           halign="center">
            Need help logging in?
          </text>

          <button
           follows="left|top"
           image_unselected="PushButton_Sign"
           image_pressed="PushButton_Sign_Pressed"
           image_hover_unselected="PushButton_Sign_Over"
           label="Create account"
           label_color="White"
           label_color_disabled="Black"
           font="SansSerifMedium"
           font.style="BOLD"
           name="sign_btn"
           draw_focus_border="false"
           hover_hand_cursor="true"
           width="195"
           height="34"
           left="0"
           top="67"
           pad_bottom="1" />
        </panel>

      </layout_panel>

      <layout_panel
       auto_resize="true"
       user_resize="false"
       layout="topleft"
       name="rail_right_spacer"
       background_visible="false"
       min_width="0"
       expanded_min_dim="0"
       width="1" />
    </layout_stack>
  </panel>
</panel>